{
  "name": "sites-project",
  "version": "0.1.3",
  "private": true,
  "main": "desktop/bootstrap.cjs",
  "description": "Thor Track desktop shipment watch",
  "author": "Thor Track contributors",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "start": "node scripts/start-desktop.mjs",
    "desktop": "node scripts/start-desktop.mjs",
    "desktop:dev": "node scripts/start-desktop.mjs --dev",
    "desktop:pack": "npm run build && electron-builder --win --x64 --dir",
    "desktop:dist": "npm run build && electron-builder --win --x64 --publish never",
    "web:start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop.browser.mjs",
    "test:desktop:notifications": "node tests/desktop-notifications.browser.mjs",
    "test:desktop:runtime": "node --test tests/desktop-runtime.integration.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "miniflare": "4.20260515.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
